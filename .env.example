# Configuración de la base de datos PostgreSQL
POSTGRES_DB=control_asistencia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contraseña_segura_aqui

# Configuración de Spring Boot
SPRING_PROFILE=prod
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=tu_contraseña_segura_aqui

# URL base para la generación de códigos QR
APP_QR_BASE_URL=http://localhost:8080

# Configuración JWT
JWT_SECRET=clave-secreta-super-segura-para-desarrollo-cambiar-en-produccion-1234567890
JWT_EXPIRATION=86400000

# Credenciales del usuario administrador por defecto
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin